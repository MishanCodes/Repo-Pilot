# Copy this file to .env and fill in your key to enable the LLM layer
# (Q&A answers + plain-language explanations of static findings).
# Without a key, RepoPilot still runs and shows raw static-analysis
# results — it just skips the natural-language explanation step.

OPENAI_API_KEY=
REPOPILOT_MODEL=gpt-4o-mini
PORT=5000
